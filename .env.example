# ZITADEL OIDC (PKCE — no client secret needed)
ZITADEL_CLIENT_ID=
ZITADEL_ISSUER=https://{instance}.zitadel.cloud
ZITADEL_REDIRECT_URI=http://localhost:3000/api/auth/callback

# JWT
JWT_SECRET=

# Encryption (64 hex chars = 32 bytes)
ENCRYPTION_KEY=

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/totp_vault

# App
APP_URL=http://localhost:5173
COOKIE_DOMAIN=localhost
ENVIRONMENT=dev

# Nginx (Docker Compose only)
MAIN_DOMAIN=localhost
# Optional: serve API on a separate domain, e.g. api.vault.example.com
# Both /api (on main domain) and the subdomain work simultaneously
API_DOMAIN_URL=
