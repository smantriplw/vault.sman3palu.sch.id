{
  "name": "totp-vault",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "bun --cwd apps/api dev",
    "dev:web": "bun --cwd apps/web dev",
    "dev": "concurrently \"bun run dev:api\" \"bun run dev:web\"",
    "db:generate": "bun --cwd apps/api db:generate",
    "db:migrate": "bun --cwd apps/api db:migrate",
    "db:push": "bun --cwd apps/api db:push",
    "typecheck": "bun --cwd apps/api typecheck && bun --cwd apps/web typecheck",
    "sbom": "bash scripts/generate-sbom.sh",
    "rotate-keys": "bash scripts/rotate-keys.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0"
  }
}
